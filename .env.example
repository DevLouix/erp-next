# Copy to `.env` (gitignored). Loaded by the app via dotenv in development, by
# the containers via env_file, and by `docker compose` for variable substitution.

# ─────────────────────────────────────────────────────────────────────────────
# Platform API
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Public origin of this platform. Used for the OAuth redirect URI and for the
# CSRF origin check. Must match what Truemoi has registered as a redirect URI.
PUBLIC_BASE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Platform database (metadata only — never ERPNext business data)
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://erpnext:erpnext@localhost:5432/erpnext_platform
# Used only by the opt-in integration test.
TEST_DATABASE_URL=postgresql://erpnext:erpnext@localhost:5433/erpnext_platform_test

# ─────────────────────────────────────────────────────────────────────────────
# Sessions
# ─────────────────────────────────────────────────────────────────────────────
# At least 32 characters. Generate with: openssl rand -base64 48
SESSION_COOKIE_SECRET=change-me-to-a-long-random-secret-value-000000
SESSION_COOKIE_NAME=erpnext_platform_session
SESSION_TTL_HOURS=168
# true in production (requires HTTPS)
COOKIE_SECURE=false

# ─────────────────────────────────────────────────────────────────────────────
# Truemoi OAuth (@truemoi/sdk)
# ─────────────────────────────────────────────────────────────────────────────
TRUEMOI_CLIENT_ID=your-truemoi-client-id
# Only for a Traditional (confidential) app; omit for a public SPA/Native client.
TRUEMOI_CLIENT_SECRET=
TRUEMOI_AUTH_DOMAIN=auth.truemoi.com
TRUEMOI_API_URL=https://api.truemoi.com
TRUEMOI_AUTH_REALM=truemoi
TRUEMOI_SCOPES=openid email profile offline_access
# Comma-separated Truemoi role claims that map to platform admin.
TRUEMOI_ADMIN_ROLES=platform-admin,admin
# Comma-separated emails that are always platform admins (bootstrap).
ADMIN_EMAILS=

# ─────────────────────────────────────────────────────────────────────────────
# Provisioning (consumed by the worker)
# ─────────────────────────────────────────────────────────────────────────────
# Wildcard DNS *.PROVISIONING_BASE_DOMAIN must point at the reverse proxy.
PROVISIONING_BASE_DOMAIN=apps.example.com
BENCH_PATH=/home/frappe/frappe-bench
BENCH_BIN=bench
# Existing MariaDB server (do NOT create a new one per site).
MARIADB_HOST=
MARIADB_ROOT_PASSWORD=change-me
# Legacy fallback for provision jobs created before per-instance credentials.
ERPNEXT_ADMIN_PASSWORD=change-me
# Generate once with `openssl rand -base64 32`, then use the same value in the
# API and worker deployment secrets. Required for per-instance login recovery.
# Do not rotate while encrypted S3/site credentials are stored.
BACKUP_CREDENTIALS_ENCRYPTION_KEY=

PROVISION_MAX_ATTEMPTS=5
# Running jobs with locks older than this are recovered on worker startup and
# every poll; queued due jobs are claimed immediately after restart.
PROVISION_LOCK_TIMEOUT_MS=900000
PROVISION_ROUTING_MODE=skip
WORKER_POLL_INTERVAL_MS=3000
HEALTHCHECK_TIMEOUT_MS=120000
HEALTHCHECK_INTERVAL_MS=5000
# Set by the bundled Compose stack to check through frappe-frontend internally.
HEALTHCHECK_BASE_URL=

LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────────
# Docker Compose (also used for `${...}` substitution in docker-compose.yml)
# ─────────────────────────────────────────────────────────────────────────────
# Prefix for every container/volume in the stack (e.g. `erpnext-frappe-db-1`).
COMPOSE_PROJECT_NAME=erpnext
# ERPNext/Frappe image tag for the Bench and the provisioning worker.
ERPNEXT_VERSION=v16.51.1
# Default site created once on first boot (also the nginx default server).
BOOTSTRAP_SITE=frontend
# Password for the platform's own PostgreSQL database.
PLATFORM_DB_PASSWORD=erpnext
# strict | best-effort | skip — how the worker treats `bench setup nginx`.
# The bundled stack uses skip because its separate Frappe frontend routes by Host.
PROVISION_ROUTING_MODE=skip

# Host ports published by docker-compose. Change these when another container
# already owns a port — no code changes needed. Container-internal ports are
# fixed (platform API 3000, Frappe ingress 8080, PostgreSQL 5432).
# Keep PUBLIC_BASE_URL and TEST_DATABASE_URL in sync when you change them.
PLATFORM_API_PORT=3000
PLATFORM_DB_PORT=5432
FRAPPE_HTTP_PORT=8080
PLATFORM_TEST_DB_PORT=5433

# ── Dokploy overlay (docker-compose.dokploy.yml) ────────────────────────────
# Only used when the overlay is applied. PUBLIC_HOST is the bare hostname of the
# platform (no scheme); customer sites come from PROVISIONING_BASE_DOMAIN.
PUBLIC_HOST=erp.example.com
# Dokploy's shared Traefik network and certificate resolver names.
DOKPLOY_NETWORK=dokploy-network
TRAEFIK_CERTRESOLVER=letsencrypt
TRAEFIK_WILDCARD_CERTRESOLVER=letsencrypt-dns
# The Dokploy Traefik instance must mount this same Docker volume read-only and
# watch its mounted directory with the file provider (see docs/deployment.md).
CUSTOM_DOMAIN_ROUTES_VOLUME=erpnext-custom-domain-routes
CUSTOM_DOMAIN_ROUTES_DIR=/var/lib/erpnext/custom-domain-routes
CUSTOM_DOMAIN_UPSTREAM_URL=http://frappe-frontend:8080
CUSTOM_DOMAIN_CERT_RESOLVER=letsencrypt
CUSTOM_DOMAIN_HTTP_ENTRYPOINT=web
CUSTOM_DOMAIN_HTTPS_ENTRYPOINT=websecure
