// Platform database schema.
//
// IMPORTANT: This database stores PLATFORM metadata only (accounts, ownership,
// provisioning state). Customer ERPNext business data lives in each site's own
// MariaDB database and is never mirrored here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  oauthSubject String   @unique @map("oauth_subject")
  email        String
  name         String?
  role         String   @default("user")
  disabled     Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  instances Instance[]
  sessions  Session[]

  @@map("users")
}

model Instance {
  id           String   @id @default(cuid())
  ownerUserId  String   @map("owner_user_id")
  companyName  String   @map("company_name")
  siteName     String   @unique @map("site_name")
  hostname     String   @unique
  status       String   @default("queued")
  errorMessage String?  @map("error_message")
  idempotencyKey String? @map("idempotency_key")
  adminPasswordCiphertext String? @map("admin_password_ciphertext")
  pendingAdminPasswordCiphertext String? @map("pending_admin_password_ciphertext")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  owner User              @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  jobs  ProvisioningJob[]

  @@unique([ownerUserId, idempotencyKey], name: "owner_idempotency_key")
  @@index([ownerUserId])
  @@map("instances")
}

model ProvisioningJob {
  id          String    @id @default(cuid())
  instanceId  String    @map("instance_id")
  type        String    @default("provision")
  siteBackupId String?  @map("site_backup_id")
  status      String    @default("queued")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  nextRunAt   DateTime  @default(now()) @map("next_run_at")
  lockedAt    DateTime? @map("locked_at")
  cleanupBeforeRun Boolean @default(false) @map("cleanup_before_run")
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([status, nextRunAt])
  @@index([instanceId])
  @@map("provisioning_jobs")
}

model SiteBackup {
  id              String    @id @default(cuid())
  siteName        String    @map("site_name")
  hostname        String
  status          String    @default("queued")
  parts           Json      @default("[]")
  createdByUserId String?   @map("created_by_user_id")
  errorMessage    String?   @map("error_message")
  createdAt       DateTime  @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")

  @@index([siteName, createdAt])
  @@map("site_backups")
}

model SiteBackupSettings {
  id                Int       @id @default(1)
  automaticEnabled  Boolean   @default(false) @map("automatic_enabled")
  intervalHours     Int       @default(24) @map("interval_hours")
  nextRunAt         DateTime? @map("next_run_at")
  s3Endpoint        String?   @map("s3_endpoint")
  s3Bucket          String?   @map("s3_bucket")
  s3Region          String?   @map("s3_region")
  s3AccessKeyCiphertext String? @map("s3_access_key_ciphertext")
  s3SecretKeyCiphertext String? @map("s3_secret_key_ciphertext")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("site_backup_settings")
}

model Session {
  id           String   @id @default(cuid())
  tokenHash    String   @unique @map("token_hash")
  userId       String   @map("user_id")
  accessToken  String?  @map("access_token")
  refreshToken String?  @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model OAuthTransaction {
  state        String   @id
  codeVerifier String   @map("code_verifier")
  nonce        String
  redirectUri  String   @map("redirect_uri")
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at")

  @@map("oauth_transactions")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?  @map("actor_user_id")
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([actorUserId])
  @@index([action])
  @@map("audit_logs")
}

// A platform-state snapshot, including encrypted login credential ciphertext.
// Restores need the same BACKUP_CREDENTIALS_ENCRYPTION_KEY as the source.
model BackupSnapshot {
  id              String   @id @default(cuid())
  label           String?
  schemaVersion   Int      @map("schema_version")
  createdByUserId String?  @map("created_by_user_id")
  counts          Json
  payload         Json
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("backup_snapshots")
}
