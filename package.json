{
  "name": "erp-next-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-tenant platform that provisions ERPNext sites on a shared Frappe Bench deployment",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server-entry.ts",
    "start": "tsx src/server-entry.ts",
    "worker": "tsx src/worker-entry.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:up": "docker compose up -d platform-postgres platform-postgres-test",
    "db:down": "docker compose down",
    "deploy": "bash deploy.sh",
    "stack:up": "docker compose up -d --build",
    "stack:down": "docker compose down",
    "stack:logs": "docker compose logs -f platform-api platform-worker",
    "backup:export": "tsx src/scripts/backup.ts export",
    "backup:import": "tsx src/scripts/backup.ts import"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@prisma/client": "^6.3.1",
    "@truemoi/sdk": "^0.0.5",
    "dotenv": "^18.0.8",
    "fastify": "^5.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
